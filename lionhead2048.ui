<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name lionhead2048.ui -->
  <requires lib="gtk" version="4.20"/>
  <object class="GtkApplicationWindow" id="main_window">
    <property name="default-height">300</property>
    <property name="default-width">400</property>
    <property name="title">Lionhead 2048</property>
    <child>
      <object class="GtkBox">
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkButton" id="button1">
                <property name="label">Change the World</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Things are fine as is.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button2">
            <property name="label">Horizontal Button</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
